# App access passcode (required — protects the app)
MAIL_PASSCODE=

# All 4 mailboxes as a JSON array (required)
# Champ optionnel "manual": true → jamais de polling automatique (le cron
# et l'overview l'ignorent) : la boîte n'est relevée qu'à son ouverture
# (/api/account). Utile pour les fournisseurs qui bloquent les logins IMAP
# répétés depuis des IP de datacenter — ex. free.fr.
MAIL_ACCOUNTS='[{"id":"free","label":"flodef@free.fr","manual":true,"imap":{"host":"imap.free.fr","port":993,"secure":true,"user":"flodef@free.fr","password":"..."},"smtp":{"host":"smtp.free.fr","port":465,"secure":true,"user":"flodef@free.fr","password":"...","from":"flodef@free.fr"}}]'

# Neon Postgres (push subscriptions + aside pile + cron state)
DATABASE_URL=

# Web Push (generate: bunx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:flo@fims.fi

# Protects /api/cron + /api/reminders — cron-job.org sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# AI features (draft generate/improve, note titles) — optional, local fallbacks without it
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Bot token (OpenClaw) — Bearer for GET/POST /api/tasks + /api/notes only
BOT_API_TOKEN=

# Agenda reminder emails
# Recipient of reminder emails (REQUIRED for /api/reminders — without it, due reminders stay armed and unsent)
REMINDER_TO=
# Account id used to send them (default: first account in MAIL_ACCOUNTS)
REMINDER_ACCOUNT=
